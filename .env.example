# Canonical site origin, used for canonical URLs, Open Graph/Twitter images,
# the sitemap and robots.txt. Production: https://psyixel.com
# Leave unset in development (falls back to http://localhost:3000); production
# builds fall back to https://psyixel.com if it is missing.
NEXT_PUBLIC_SITE_URL=https://psyixel.com

# Last.fm "What I'm listening to" on /music (free key: https://www.last.fm/api/account/create).
# Without it the section shows a link to the Last.fm profile instead.
LASTFM_API_KEY=

# Contact form delivery, option 1 (simplest): Web3Forms, a form-to-email
# service. Get a free access key at https://web3forms.com by entering the
# address that should receive messages. The key is public by design, so it is
# a NEXT_PUBLIC_ variable. When set, it takes priority over Resend below.
NEXT_PUBLIC_WEB3FORMS_KEY=

# Contact form delivery, option 2: Resend (https://resend.com). Server-side only:
# never prefix these with NEXT_PUBLIC_ and never commit real values.
# Without RESEND_API_KEY + CONTACT_TO_EMAIL the form tells visitors their
# message was NOT sent and offers the public email address instead.
RESEND_API_KEY=
# Inbox that receives messages. The visitor's address is set as Reply-To.
CONTACT_TO_EMAIL=hello@psyixel.com
# Sender. Only switch to the psyixel.com address once psyixel.com is verified
# as a sending domain in Resend; until then Resend's test sender
# (onboarding@resend.dev) only delivers to the Resend account owner's address.
# CONTACT_FROM_EMAIL="Psyixel <hello@psyixel.com>"
CONTACT_FROM_EMAIL="Psyixel <onboarding@resend.dev>"
